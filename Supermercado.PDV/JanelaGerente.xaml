<Window x:Class="Supermercado.PDV.JanelaGerente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Painel do Gerente - Retaguarda" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9">

    <Grid Margin="15">
        <TabControl Background="White" BorderBrush="#DEE2E6">
            
            <!-- ABAS DO PAINEL GERENCIAL -->
            
            <!-- 1. VENDAS E COMPROVANTES -->
            <TabItem Header=" 📊 Vendas e Comprovantes " Padding="10,8" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Filtrar por Data:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                        <DatePicker x:Name="dpFiltroData" Width="150" SelectedDateChanged="DpFiltroData_SelectedDateChanged"/>
                        <Button Content="Atualizar Lista" Width="120" Height="30" Margin="15,0,0,0" Click="BtnAtualizarVendas_Click" Background="#0d6efd" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>

                    <DataGrid x:Name="dgVendas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" 
                              Background="White" BorderBrush="#DEE2E6" AlternatingRowBackground="#F8F9FA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cód. Venda" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Data / Hora" Binding="{Binding DataVenda, StringFormat=\{жьdd/MM/yyyy HH:mm:ss\}}" Width="150"/>
                            <DataGridTextColumn Header="Total (R$)" Binding="{Binding TotalVenda, StringFormat=C2}" Width="110"/>
                            <DataGridTextColumn Header="Forma de Pagamento" Binding="{Binding FormaPagamento}" Width="*"/>
                            <DataGridTextColumn Header="Troco" Binding="{Binding Troco, StringFormat=C2}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="Visualizar / Imprimir Comprovante" Width="240" Height="40" Background="#198754" Foreground="White" FontWeight="Bold" FontSize="13" Click="BtnImprimirComprovante_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 2. FECHAMENTO DE CAIXA -->
            <TabItem Header=" 💰 Fechamento de Caixa " Padding="10,8" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="10">
                        <TextBlock Text="Resumo do Caixa (Hoje)" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Total de Vendas Realizadas:" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="lblResumoQtdVendas" Text="0" FontSize="16" Margin="0,0,0,15" Foreground="#0d6efd"/>

                        <TextBlock Text="Faturamento Total do Dia:" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="lblResumoFaturamento" Text="R$ 0,00" FontSize="22" FontWeight="Bold" Margin="0,0,0,15" Foreground="#198754"/>
                        
                        <Button Content="Gerar Relatório de Fechamento" Width="220" Height="45" Background="#ffc107" Foreground="#000" FontWeight="Bold" Click="BtnGerarFechamento_Click"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Extrato Detalhado do Caixa" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtRelatorioCaixa" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="400" Background="White" FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3. CONTROLE DE ESTOQUE -->
            <TabItem Header=" 📦 Controle de Estoque " Padding="10,8" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Gerenciamento e Reposição de Estoque" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <DataGrid x:Name="dgEstoque" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                              Background="White" BorderBrush="#DEE2E6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código de Barras" Binding="{Binding CodigoBarras}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Estoque Atual" Binding="{Binding EstoqueAtual}" Width="120"/>
                            <DataGridTextColumn Header="Estoque Mínimo" Binding="{Binding EstoqueMinimo}" Width="120"/>
                            <DataGridTextColumn Header="Preço Venda (R$)" Binding="{Binding PrecoVenda, StringFormat=C2}" Width="130" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 4. CADASTRO DE FORNECEDORES -->
            <TabItem Header=" 🏢 Fornecedores " Padding="10,8" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Novo Fornecedor" Width="140" Height="35" Background="#198754" Foreground="White" FontWeight="Bold" Click="BtnNovoFornecedor_Click" Margin="0,0,10,0"/>
                        <Button Content="Excluir Selecionado" Width="140" Height="35" Background="#dc3545" Foreground="White" FontWeight="Bold" Click="BtnExcluirFornecedor_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgFornecedores" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White" BorderBrush="#DEE2E6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Nome Fantasia" Binding="{Binding NomeFantasia}" Width="200"/>
                            <DataGridTextColumn Header="Razão Social" Binding="{Binding RazaoSocial}" Width="220"/>
                            <DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="150"/>
                            <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="140"/>
                            <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 5. CONFIGURAÇÕES E IMPRESSORA -->
<TabItem Header=" 🖨️ Configurações " Padding="10,8" FontSize="14" FontWeight="SemiBold">
    <Grid Margin="20">
        <StackPanel Width="400" HorizontalAlignment="Left">
            <TextBlock Text="Configuração de Impressora Térmica" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
            
            <TextBlock Text="Selecione a Impressora Instalada no Windows:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbImpressoras" Height="35" FontSize="14" Margin="0,0,0,15"/>

            <Button Content="Salvar Configuração de Impressora" Height="40" Background="#198754" Foreground="White" FontWeight="Bold" Click="BtnSalvarImpressora_Click"/>
        </StackPanel>
    </Grid>
</TabItem>

        </TabControl>
    </Grid>
</Window>