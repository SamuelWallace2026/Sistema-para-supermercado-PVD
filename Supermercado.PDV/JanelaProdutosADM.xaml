<Window x:Class="Supermercado.PDV.JanelaProdutosADM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backoffice - Gestão de Produtos e Estoque" Height="680" Width="980"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="CADASTRO DE PRODUTOS E ESTOQUE" FontSize="20" FontWeight="Bold" Foreground="#002244" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- FORMULÁRIO DE CADASTRO E EDIÇÃO -->
        <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="6" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Color="#CCCCCC" Direction="270" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <!-- LINHA 1: CÓD. BARRAS / DESCRIÇÃO / CATEGORIA -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Cód. Barras:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtCodigoBarras" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                    <TextBlock Text="Descrição:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtDescricao" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,0,0,10">
                    <TextBlock Text="Categoria:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbCategoria" Height="30" VerticalContentAlignment="Center" DisplayMemberPath="Nome" SelectedValuePath="Id"/>
                </StackPanel>

                <!-- LINHA 2: PREÇO / ESTOQUE ATUAL / ESTOQUE MÍNIMO -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Preço Venda (R$):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtPrecoVenda" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                    <TextBlock Text="Estoque Atual:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtEstoqueAtual" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,10">
                    <TextBlock Text="Estoque Mínimo (Alerta):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtEstoqueMinimo" Height="30" VerticalContentAlignment="Center" Text="5"/>
                </StackPanel>

                <!-- BOTÕES DE AÇÃO -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button x:Name="btnLimpar" Content="Limpar / Novo" Width="110" Height="32" Margin="0,0,10,0" Background="#6C757D" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnLimpar_Click"/>
                    <Button x:Name="btnSalvar" Content="Salvar Produto" Width="120" Height="32" Margin="0,0,10,0" Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSalvar_Click"/>
                    <Button x:Name="btnExcluir" Content="Excluir" Width="90" Height="32" Background="#DC3545" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnExcluir_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABELA DE PRODUTOS -->
        <DataGrid x:Name="dgProdutos" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowBackground="White" AlternatingRowBackground="#F8F9FA" FontSize="13" RowHeight="32"
                  SelectionChanged="DgProdutos_SelectionChanged">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#002244"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Cód. Barras" Binding="{Binding CodigoBarras}" Width="140"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria.Nome}" Width="130"/>
                <DataGridTextColumn Header="Preço" Binding="{Binding PrecoVenda, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Est. Atual" Binding="{Binding EstoqueAtual}" Width="90"/>
                <DataGridTextColumn Header="Est. Mínimo" Binding="{Binding EstoqueMinimo}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- BARRA INFERIOR DE FILTRAGEM E ALERTAS DE ESTOQUE -->
        <Border Grid.Row="3" Background="#E9ECEF" Padding="10" Margin="0,15,0,0" CornerRadius="4">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Buscar:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtFiltro" Width="220" Height="28" VerticalContentAlignment="Center" TextChanged="TxtFiltro_TextChanged"/>

                    <CheckBox x:Name="chkEstoqueCritico" Content="⚠️ Exibir Apenas Estoque Crítico"
                              Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#C82333"
                              Checked="ChkEstoqueCritico_Changed" Unchecked="ChkEstoqueCritico_Changed"/>
                </StackPanel>

                <TextBlock x:Name="lblTotalProdutos" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="Total: 0 produtos cadastrados" FontWeight="Bold" Foreground="#495057"/>
            </Grid>
        </Border>
    </Grid>
</Window>