<Window x:Class="Supermercado.PDV.JanelaPesquisaProduto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pesquisar Produto (F2)" Height="500" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#002244" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CONSULTA DE PRODUTOS" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="DIGITE A DESCRIÇÃO OU CÓDIGO DE BARRAS:" Foreground="#7A99B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPesquisa" Height="38" FontSize="18" VerticalContentAlignment="Center" TextChanged="TxtPesquisa_TextChanged"/>
        </StackPanel>

        <DataGrid x:Name="dgProdutos" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="None" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                  FontSize="14" RowHeight="30" MouseDoubleClick="DgProdutos_MouseDoubleClick">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Cód. Barras" Binding="{Binding CodigoBarras}" Width="140"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                <DataGridTextColumn Header="Preço Unit." Binding="{Binding PrecoVenda, StringFormat=C}" Width="110"/>
                <DataGridTextColumn Header="Estoque" Binding="{Binding EstoqueAtual}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- RODAPÉ CORRIGIDO COM GRID EM VEZ DE STACKPANEL SPACEBETWEEN -->
        <Border Grid.Row="3" Background="#0A3055" Padding="8" Margin="0,10,0,0" CornerRadius="4">
            <Grid>
                <TextBlock HorizontalAlignment="Left" Text="[↑/↓] Navegar  |  [ENTER] Selecionar Produto" Foreground="White" FontWeight="Bold" FontSize="12"/>
                <TextBlock HorizontalAlignment="Right" Text="[ESC] Sair" Foreground="#FF8888" FontWeight="Bold" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>