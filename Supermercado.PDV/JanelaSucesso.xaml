<Window x:Class="Supermercado.PDV.JanelaSucesso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Venda Concluída" Height="360" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO COM ÍCONE/TÍTULO -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="✔" FontSize="24" Foreground="#198754" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="lblTitulo" Text="VENDA CONCLUÍDA COM SUCESSO!" FontSize="16" FontWeight="Bold" Foreground="#198754" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- DETALHES DA VENDA COM SCROLL E FONTE ALINHADA -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="lblMensagemDetalhes" 
                           Text="Detalhes da venda..." 
                           FontFamily="Consolas, Courier New" 
                           FontSize="13" 
                           Foreground="#333333" 
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- BOTÃO OK -->
        <Button Grid.Row="2" Content="OK [ENTER / ESPAÇO]" Width="160" Height="40" Background="#198754" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0" BorderThickness="0" Click="BtnOk_Click" x:Name="btnOk"/>
    </Grid>
</Window>