<Window x:Class="Supermercado.PDV.JanelaLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login do Sistema - SUPERMERCADO " Height="340" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F6F9">

    <Grid Margin="25,20,25,20">
        <StackPanel VerticalAlignment="Center">
            <!-- CABEÇALHO -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="🔐" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="SUPERMERCADO" FontSize="18" FontWeight="Bold" Foreground="#198754" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- USUÁRIO -->
            <TextBlock Text="Usuário (Login):" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Height="38" FontSize="14" Padding="8,5" VerticalContentAlignment="Center"/>

            <!-- SENHA -->
            <TextBlock Text="Senha:" FontWeight="SemiBold" Foreground="#333333" Margin="0,12,0,5"/>
            <PasswordBox x:Name="txtSenha" Height="38" FontSize="14" Padding="8,5" VerticalContentAlignment="Center"/>

            <!-- BOTÃO ENTRAR -->
            <Button Content="ENTRAR [ENTER]" Height="42" Background="#198754" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,20,0,0" BorderThickness="0" Click="BtnEntrar_Click" x:Name="btnEntrar"/>
        </StackPanel>
    </Grid>
</Window>
